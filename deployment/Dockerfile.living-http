FROM golang:1.25-alpine AS build
WORKDIR /src
COPY services/living-http/go.mod services/living-http/go.sum ./
RUN go mod download
COPY services/living-http/ ./
ENV CGO_ENABLED=0
RUN go build -trimpath -o /living-http .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates \
  && mkdir -p /data
WORKDIR /
COPY --from=build /living-http /living-http
ENV LIVING_HTTP_DATA_DIR=/data
ENV LIVING_HTTP_ADDR=:8090
EXPOSE 8090
CMD ["/living-http"]
