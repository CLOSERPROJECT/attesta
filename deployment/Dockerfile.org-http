FROM golang:1.25-alpine AS build
WORKDIR /src
COPY services/org-http/go.mod services/org-http/go.sum ./
RUN go mod download
COPY services/org-http/ ./
ENV CGO_ENABLED=0
RUN go build -trimpath -o /org-http .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates \
  && mkdir -p /data
WORKDIR /
COPY --from=build /org-http /org-http
ENV ORG_HTTP_DATA_DIR=/data
ENV ORG_HTTP_ADDR=:8090
EXPOSE 8090
CMD ["/org-http"]