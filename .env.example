ANYONE_CAN_CREATE_ACCOUNT=true
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
APPWRITE_RESET_REDIRECT_URL=http://localhost:3000/reset/confirm
APPWRITE_INVITE_REDIRECT_URL=http://localhost:3000/invite/accept
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Attesta SMTP (affiliation notifications). Empty SMTP_HOST → noop mailer.
# Host-dev (air on host → compose Mailpit): use localhost. Compose attesta service uses SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=attesta@localhost
# Leave empty for Mailpit (plain). Use starttls|true for STARTTLS, or tls for implicit TLS (465).
SMTP_SECURE=
