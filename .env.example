# Attesta environment template.
# Copy to `.env` for local defaults. Checkout-scoped ports live in `.env.worktree`
# (generated once by worktree-env). Runtime Appwrite credentials after prepare live
# in gitignored `.env.appwrite` at $ATTESTA_ROOT_DIR (repo root locally; /app in
# Coolify/local containers) — do not commit that file.

# --- Required (demo / local) ---
ANYONE_CAN_CREATE_ACCOUNT=true
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
APPWRITE_ENDPOINT=http://localhost/v1
# You choose this id (e.g. attesta). Required — prepare creates that project; not generated.
APPWRITE_PROJECT_ID=attesta
# Leave empty for prepare/bootstrap. Prepare writes the key (and echoes PROJECT_ID)
# into gitignored `.env.appwrite`; main and seed apply that file.
APPWRITE_API_KEY=

# --- Optional ---
# Public site origin for absolute links (invite/reset/verify + notification emails).
# No trailing slash. Go derives invite/reset/verify URLs from this + fixed paths;
# if unset, those links use the request host instead.
PUBLIC_BASE_URL=http://localhost:3000
APPWRITE_ORG_ASSETS_BUCKET=org-assets
# Console bootstrap (Coolify/prepare). Demo defaults are fine locally.
APPWRITE_CONSOLE_EMAIL=
APPWRITE_CONSOLE_PASSWORD=
# Checkout root for `.env.appwrite`. Go joins $ATTESTA_ROOT_DIR/.env.appwrite;
# empty ATTESTA_ROOT_DIR → cwd-relative. Host-dev scripts (worktree-env /
# worktree-compose / dev-env) export the checkout root; containers set /app.
# ATTESTA_ROOT_DIR=
# Cloudflare Turnstile (leave both empty to disable locally).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Attesta SMTP (affiliation notifications). Empty SMTP_HOST → noop mailer.
# Host-dev (air on host → compose Mailpit): use localhost. Compose attesta service uses SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=attesta@localhost
# Leave empty for Mailpit (plain). Use starttls|true for STARTTLS, or tls for implicit TLS (465).
SMTP_SECURE=
SESSION_TTL_DAYS=30
ATTACHMENT_MAX_BYTES=
ORG_LOGO_MAX_BYTES=
WORKFLOW_CONFIG=
FORMATA_ARCH_URL=
CATEGORIES_SEED=
# Truthy enables prepare empty-only demo seed (Coolify Preview / worktree stacks).
ATTESTA_SEED=

# --- Generated (do not put secrets here; see `.env.worktree`) ---
# PORT=3000
# VITE_PORT=5173
# DOCKER_APP_PORT=3030
# MONGODB_PORT= / CERBOS_PORT= / APPWRITE_HTTP_PORT= / MAILPIT_*_PORT=
# COMPOSE_PROJECT_NAME=
