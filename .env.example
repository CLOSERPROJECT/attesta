# Attesta environment template.
# Copy to `.env` for local defaults.
# Ports / compose identity: `.env.worktree` (generated by worktree-env).
# Appwrite API key after prepare: `$ATTESTA_ROOT_DIR/.env.appwrite` (gitignored).

# --- App ---
ANYONE_CAN_CREATE_ACCOUNT=true
COOKIE_SECURE=false
ADMIN_EMAIL=admin@attesta.com
ADMIN_PASSWORD=admin@attesta.com
SESSION_TTL_DAYS=30

# --- Appwrite ---
# PROJECT_ID is chosen by you (required). API_KEY is generated into `.env.appwrite`.
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=attesta
APPWRITE_API_KEY=
APPWRITE_ORG_ASSETS_BUCKET=org-assets

# Console bootstrap for prepare (demo defaults if empty).
APPWRITE_CONSOLE_EMAIL=
APPWRITE_CONSOLE_PASSWORD=

# --- Public URL ---
# Origin for invite/reset/verify and notification links (no trailing slash).
# Unset → request host. Coolify compose sets this from SERVICE_FQDN_ATTESTA_3000.
PUBLIC_BASE_URL=http://localhost:3000

# --- Turnstile ---
# Leave both empty to disable locally.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMTP ---
# Empty SMTP_HOST → noop mailer.
# Host-dev → localhost (Mailpit). Compose attesta service → SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=attesta@localhost
# Empty for Mailpit (plain). starttls|true for STARTTLS; tls for implicit TLS (465).
SMTP_SECURE=

# --- Optional ---
ATTACHMENT_MAX_BYTES=
ORG_LOGO_MAX_BYTES=
# Truthy → prepare empty-only demo seed (Coolify Preview / worktree stacks).
ATTESTA_SEED=

# Checkout root for `.env.appwrite`. Host-dev scripts export it; containers use /app.
# Empty → cwd-relative `.env.appwrite`.
# ATTESTA_ROOT_DIR=

# --- Generated (`.env.worktree`; do not put secrets here) ---
# PORT=3000
# VITE_PORT=5173
# DOCKER_APP_PORT=3030
# MONGODB_PORT= / CERBOS_PORT= / APPWRITE_HTTP_PORT= / MAILPIT_*_PORT=
# COMPOSE_PROJECT_NAME=
