# Country of production used on UNTP passports for streams that do not declare
# one (dpp.countryOfProduction). "CODE" or "CODE,Name"; ISO 3166-1 alpha-2.
# Unset emits the explicit "unspecified" code ZZ rather than guessing.
DPP_COUNTRY_OF_PRODUCTION=
